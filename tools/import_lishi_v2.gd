extends SceneTree
## Imports the "LiShi Mahjong Graphics Refresh v2" pack into res://art/lishi_v2/.
##   godot --headless --path . -s res://tools/import_lishi_v2.gd -- <pack_dir>
##   godot --headless --path . --import
##
## Deterministic: re-running on the same pack reproduces the same files. Only runtime art is
## imported (no previews, sources, SVGs, marketing concepts or text-baked sample sprites).
##
## What it does beyond copying:
##   * Tile faces are re-fitted into the game's logical tile slot (BoardFit.ASPECT = 164/128,
##     opaque body = BoardView.BODY). The pack's faces are not uniformly framed (body heights
##     vary ~7%), so each face is cropped to its own opaque bounds and scaled onto the body.
##     Board geometry, hit-testing and the level tools therefore stay unchanged.
##   * Five faces in the pack show the wrong pip count (bamboo 5/6/8 and circle 7/8; circle 8
##     is identical to circle 9). They are rebuilt from the pack's own pips on the same face,
##     in every colour theme, and listed in MANIFEST.json under "repaired".
##   * State overlays are aligned with the same transform as a full-height reference face.
##   * Environment props are trimmed, cleaned of detached fragments and bottom-centred on a
##     square canvas (Bloom anchors sprites at bottom-centre).
##   * Pre-blurred 540x960 board backgrounds are derived from the 1080x1920 soft boards.
##   * Placeholders for pieces the pack lacks (rose buttons) are generated from pack art and
##     listed in MANIFEST.json under "placeholders".

const OUT := "res://art/lishi_v2/"
const BODY := Rect2(0.04, 0.025, 0.915, 0.905)  ## must match BoardView.BODY
const SLOT_HI := Vector2i(192, 246)             ## 192 x (192 * 164/128)
const SLOT_LO := Vector2i(96, 123)
const THEMES := ["sakura_premium", "pearl_ocean", "moonlit_lilac", "jade_garden"]
const STATES := ["selected", "hint", "blocked", "match", "pressed"]
const ATLAS_COLS := 7
const PIP_DIST := 0.10                          ## colour distance that counts as "not face"
## Props whose sprite-sheet cut kept a neighbour's gold finial fused to the object (fraction of
## the height below which gold pixels are cleared).
const PROP_GOLD_LEFTOVERS := {"pink_flower_bush.png": 0.7}

var pack: String
var manifest := {"source_pack": "LiShi_Mahjong_Graphics_Refresh_v2", "copied": [], "generated": [], "repaired": [], "placeholders": []}
var face_ids: Array = []


func _init() -> void:
	var args := OS.get_cmdline_user_args()
	if args.is_empty() or not DirAccess.dir_exists_absolute(args[0]):
		push_error("usage: godot --headless --path . -s res://tools/import_lishi_v2.gd -- <pack_dir>")
		quit(1)
		return
	pack = args[0].replace("\\", "/").trim_suffix("/") + "/"
	var ids: Variant = JSON.parse_string(FileAccess.get_file_as_string(pack + "07_metadata/mahjong_tile_ids.json"))
	face_ids = ids.face_ids
	_copy_static()
	_build_tiles()
	_build_props()
	_build_backgrounds()
	_build_placeholders()
	_build_switch_knobs()
	var f := FileAccess.open(OUT + "MANIFEST.json", FileAccess.WRITE)
	f.store_string(JSON.stringify(manifest, "  ", false))
	print("import_lishi_v2: done (%d copied, %d generated, %d repaired, %d placeholders)" % [
		manifest.copied.size(), manifest.generated.size(), manifest.repaired.size(), manifest.placeholders.size()])
	quit()


# --- files ---------------------------------------------------------------------------

func _out(rel: String) -> String:
	var p := ProjectSettings.globalize_path(OUT + rel)
	DirAccess.make_dir_recursive_absolute(p.get_base_dir())
	return p


func _copy(src_rel: String, dst_rel: String) -> void:
	var err := DirAccess.copy_absolute(pack + src_rel, _out(dst_rel))
	if err != OK:
		push_error("copy failed %s (%d)" % [src_rel, err])
		return
	manifest.copied.append({"from": src_rel, "to": OUT + dst_rel})


func _copy_dir(src_rel: String, dst_rel: String) -> void:
	for f in DirAccess.get_files_at(pack + src_rel):
		if f.get_extension().to_lower() == "png":
			_copy(src_rel + "/" + f, dst_rel + "/" + f)


func _save(img: Image, dst_rel: String, note: String) -> void:
	img.save_png(_out(dst_rel))
	manifest.generated.append({"to": OUT + dst_rel, "how": note})


func _load(src_rel: String) -> Image:
	var img := Image.load_from_file(pack + src_rel)
	img.convert(Image.FORMAT_RGBA8)
	return img


func _copy_static() -> void:
	for f in ["logo_ornate_large.png", "logo_ornate_large_1024.png", "logo_ornate_small.png", "logo_ornate_small_1024.png", "emblem_lotus.png", "emblem_tile.png", "emblem_bridge.png"]:
		_copy("01_branding/isolated/" + f, "branding/" + f)
	# App icons are generated by tools/make_app_icons.gd from the pack's 發-tile icon art (the
	# pack's own icon exports are inconsistent across platforms), so they are not copied here.
	for d in ["buttons", "components", "panels", "level_nodes", "icons/ivory", "icons/emerald"]:
		_copy_dir("03_ui/localizable/" + d, "ui/" + d)


# --- tiles ---------------------------------------------------------------------------

func _alpha_bbox(img: Image, thr: float = 0.5) -> Rect2i:
	var w := img.get_width()
	var h := img.get_height()
	var minx := w
	var miny := h
	var maxx := -1
	var maxy := -1
	for y in h:
		for x in w:
			if img.get_pixel(x, y).a > thr:
				minx = mini(minx, x)
				maxx = maxi(maxx, x)
				miny = mini(miny, y)
				maxy = maxi(maxy, y)
	if maxx < 0:
		return Rect2i()
	return Rect2i(minx, miny, maxx - minx + 1, maxy - miny + 1)


func _body_rect(slot: Vector2i) -> Rect2:
	return Rect2(BODY.position * Vector2(slot), BODY.size * Vector2(slot))


func _fit_to_slot(src: Image, ref: Rect2i, slot: Vector2i) -> Image:
	## Maps the source rectangle `ref` onto the slot's body rect; everything else follows the
	## same scale (soft edges, overlay glows), clipped to the slot.
	var body := _body_rect(slot)
	var s := body.size / Vector2(ref.size)
	var margin := 8
	var crop := Rect2i(ref.position - Vector2i(margin, margin), ref.size + Vector2i(margin * 2, margin * 2)).intersection(Rect2i(Vector2i.ZERO, src.get_size()))
	var part := src.get_region(crop)
	var new_size := Vector2i(roundi(crop.size.x * s.x), roundi(crop.size.y * s.y))
	part.resize(new_size.x, new_size.y, Image.INTERPOLATE_LANCZOS)
	var origin := body.position + (Vector2(crop.position - ref.position)) * s
	var out := Image.create(slot.x, slot.y, false, Image.FORMAT_RGBA8)
	out.blit_rect(part, Rect2i(Vector2i.ZERO, part.get_size()), Vector2i(roundi(origin.x), roundi(origin.y)))
	return out


func _build_tiles() -> void:
	var ref_face := _load("02_tiles/sakura_premium/faces/192x256/bamboo_1.png")
	var ref_box := _alpha_bbox(ref_face)
	for st in STATES:
		var ov := _load("02_tiles/sakura_premium/states/%s.png" % st)
		var hi := _fit_to_slot(ov, ref_box, SLOT_HI)
		_save(hi, "tiles/states/%s.png" % st, "pack state overlay aligned to the tile slot (ref bamboo_1)")
		var lo := hi.duplicate()
		lo.resize(SLOT_LO.x, SLOT_LO.y, Image.INTERPOLATE_LANCZOS)
		_save(lo, "tiles/states/%s_lo.png" % st, "half-size overlay")
	for theme in THEMES:
		var faces := {}
		for id in face_ids:
			var src := _load("02_tiles/%s/faces/192x256/%s.png" % [theme, id])
			faces[id] = _fit_to_slot(src, _alpha_bbox(src), SLOT_HI)
		_repair_faces(theme, faces)
		for size in [SLOT_HI, SLOT_LO]:
			_write_atlas(theme, faces, size)


func _write_atlas(theme: String, faces: Dictionary, cell: Vector2i) -> void:
	var rows := ceili(float(face_ids.size()) / ATLAS_COLS)
	var atlas := Image.create(cell.x * ATLAS_COLS, cell.y * rows, false, Image.FORMAT_RGBA8)
	var mapping := {}
	for i in face_ids.size():
		var img: Image = faces[face_ids[i]]
		if cell != img.get_size():
			img = img.duplicate()
			img.resize(cell.x, cell.y, Image.INTERPOLATE_LANCZOS)
		var at := Vector2i((i % ATLAS_COLS) * cell.x, (i / ATLAS_COLS) * cell.y)
		atlas.blit_rect(img, Rect2i(Vector2i.ZERO, cell), at)
		mapping[face_ids[i]] = {"x": at.x, "y": at.y, "width": cell.x, "height": cell.y, "index": i}
	var base := "tiles/%s/%s_%d_atlas" % [theme, theme, cell.x]
	_save(atlas, base + ".png", "faces fitted to the %dx%d tile slot" % [cell.x, cell.y])
	var meta := {"texture": base.get_file() + ".png", "cell_size": [cell.x, cell.y], "tile_count": face_ids.size(), "body": [BODY.position.x, BODY.position.y, BODY.size.x, BODY.size.y], "mapping": mapping}
	var f := FileAccess.open(_out(base + ".json"), FileAccess.WRITE)
	f.store_string(JSON.stringify(meta, "  ", false))


# --- face repair ---------------------------------------------------------------------
# Works on slot-fitted faces, which share one face template per theme, so pixel positions
# line up across faces. "Blank" = the white dragon with its red frame painted out.

func _repair_faces(theme: String, faces: Dictionary) -> void:
	var blank: Image = faces["dragon_white"].duplicate()
	var frame := _mask(blank, _face_zone(), func(c: Color, _b: Color) -> bool: return c.r - maxf(c.g, c.b) > 0.12)
	_inpaint(blank, _dilate(frame, blank.get_size(), 3))
	var b9 := _grid(faces["bamboo_9"], 3, 3)    # 3 x 3 short sticks
	var b4 := _grid(faces["bamboo_4"], 2, 2)    # 2 x 2 tall sticks
	var c9 := _grid(faces["circle_9"], 3, 3)    # rows: green, red, green
	if b9.size() != 9 or b4.size() != 4 or c9.size() != 9:
		push_error("%s: pip detection failed (b9=%d b4=%d c9=%d); faces left unrepaired" % [theme, b9.size(), b4.size(), c9.size()])
		return
	var short_stick := _extract(faces["bamboo_9"], blank, b9[4])
	var tall_stick := _extract(faces["bamboo_4"], blank, b4[0])
	var green_dot := _extract(faces["circle_9"], blank, c9[1])  # row 0, centre column
	var red_dot := _extract(faces["circle_9"], blank, c9[4])
	var xs := [b9[0].get_center().x, b9[1].get_center().x, b9[2].get_center().x]
	var ys3 := [b9[1].get_center().y, b9[4].get_center().y, b9[7].get_center().y]
	var ys2 := [b4[0].get_center().y, b4[2].get_center().y]
	var dot_area := Rect2(c9[0].position, c9[8].end - c9[0].position)
	dot_area = dot_area.grow_individual(0, dot_area.size.y * 0.07, 0, dot_area.size.y * 0.07)

	# bamboo_5: 2-1-2 (traditional quincunx) with short sticks
	var b5: Image = _cleared(faces["bamboo_5"], blank)
	for p in [Vector2(xs[0], ys3[0]), Vector2(xs[2], ys3[0]), Vector2(xs[1], ys3[1]), Vector2(xs[0], ys3[2]), Vector2(xs[2], ys3[2])]:
		_stamp(b5, short_stick, p, 1.0)
	faces["bamboo_5"] = b5
	# bamboo_6: two rows of three tall sticks
	var b6: Image = _cleared(faces["bamboo_6"], blank)
	for y in ys2:
		for x in xs:
			_stamp(b6, tall_stick, Vector2(x, y), 1.0)
	faces["bamboo_6"] = b6
	# bamboo_8: two rows of four tall sticks (narrowed to fit)
	var b8: Image = _cleared(faces["bamboo_8"], blank)
	var step: float = (xs[2] - xs[0]) / 3.0 * 1.12
	var x0: float = xs[1] - step * 1.5
	var k := minf(1.0, step * 0.78 / tall_stick.get_width())
	for y in ys2:
		for i in 4:
			_stamp(b8, tall_stick, Vector2(x0 + step * i, y), k)
	faces["bamboo_8"] = b8
	# circle_7: three green diagonal, four red below (traditional)
	var c7: Image = _cleared(faces["circle_7"], blank)
	var dk := dot_area.size.y * 0.25 / green_dot.get_height()
	for uv in [Vector2(0.17, 0.12), Vector2(0.5, 0.27), Vector2(0.83, 0.42)]:
		_stamp(c7, green_dot, dot_area.position + uv * dot_area.size, dk)
	for uv in [Vector2(0.3, 0.665), Vector2(0.7, 0.665), Vector2(0.3, 0.885), Vector2(0.7, 0.885)]:
		_stamp(c7, red_dot, dot_area.position + uv * dot_area.size, dk)
	faces["circle_7"] = c7
	# circle_8: two columns of four
	var c8: Image = _cleared(faces["circle_8"], blank)
	for v in [0.12, 0.373, 0.627, 0.88]:
		for u in [0.28, 0.72]:
			_stamp(c8, green_dot, dot_area.position + Vector2(u, v) * dot_area.size, dk)
	faces["circle_8"] = c8
	for id in ["bamboo_5", "bamboo_6", "bamboo_8", "circle_7", "circle_8"]:
		manifest.repaired.append({"theme": theme, "face": id, "why": "pack art shows the wrong pip count; rebuilt from the pack's own pips"})


func _face_zone() -> Rect2i:
	## Inner face area of a slot-fitted tile (excludes rim and the 3D base).
	var body := _body_rect(SLOT_HI)
	return Rect2i(body.grow_individual(-body.size.x * 0.07, -body.size.y * 0.05, -body.size.x * 0.07, -body.size.y * 0.13))


func _dist(a: Color, b: Color) -> float:
	return Vector3(a.r - b.r, a.g - b.g, a.b - b.b).length()


func _mask(img: Image, zone: Rect2i, pred: Callable, ref: Image = null) -> PackedByteArray:
	var w := img.get_width()
	var m := PackedByteArray()
	m.resize(w * img.get_height())
	for y in range(zone.position.y, zone.end.y):
		for x in range(zone.position.x, zone.end.x):
			if pred.call(img.get_pixel(x, y), ref.get_pixel(x, y) if ref else Color()):
				m[y * w + x] = 1
	return m


func _dilate(m: PackedByteArray, size: Vector2i, r: int) -> PackedByteArray:
	var out := m.duplicate()
	for y in size.y:
		for x in size.x:
			if m[y * size.x + x] == 0:
				continue
			for dy in range(-r, r + 1):
				for dx in range(-r, r + 1):
					var nx := x + dx
					var ny := y + dy
					if nx >= 0 and ny >= 0 and nx < size.x and ny < size.y and dx * dx + dy * dy <= r * r:
						out[ny * size.x + nx] = 1
	return out


func _inpaint(img: Image, m: PackedByteArray) -> void:
	## Harmonic fill of masked pixels from their surroundings (onion peel, then relaxation).
	var w := img.get_width()
	var h := img.get_height()
	var buf: Array[Color] = []
	buf.resize(w * h)
	for y in h:
		for x in w:
			buf[y * w + x] = img.get_pixel(x, y)
	var known := PackedByteArray()
	known.resize(w * h)
	var todo: PackedInt32Array = []
	for i in w * h:
		known[i] = 1 - m[i]
		if m[i] == 1:
			todo.append(i)
	var dirs := [Vector2i(1, 0), Vector2i(-1, 0), Vector2i(0, 1), Vector2i(0, -1)]
	while not todo.is_empty():
		var next: PackedInt32Array = []
		var filled: PackedInt32Array = []
		for i in todo:
			var acc := Color(0, 0, 0, 0)
			var n := 0
			for d in dirs:
				var nx: int = i % w + d.x
				var ny: int = i / w + d.y
				if nx >= 0 and ny >= 0 and nx < w and ny < h and known[ny * w + nx] == 1:
					acc += buf[ny * w + nx]
					n += 1
			if n > 0:
				buf[i] = acc / n
				filled.append(i)
			else:
				next.append(i)
		if filled.is_empty():
			break
		for i in filled:
			known[i] = 1
		todo = next
	var masked: PackedInt32Array = []
	for i in w * h:
		if m[i] == 1:
			masked.append(i)
	for _it in 60:
		for i in masked:
			var x := i % w
			var y := i / w
			if x > 0 and y > 0 and x < w - 1 and y < h - 1:
				buf[i] = (buf[i - 1] + buf[i + 1] + buf[i - w] + buf[i + w]) * 0.25
	for i in masked:
		img.set_pixel(i % w, i / w, buf[i])


func _pip_mask(img: Image, blank: Image) -> PackedByteArray:
	return _mask(img, _face_zone(), func(c: Color, b: Color) -> bool: return _dist(c, b) > PIP_DIST, blank)


func _is_pip(c: Color) -> bool:
	## Jade-green or lacquer-red pip ink (pink petals and cream face do not qualify).
	var green := c.g - maxf(c.r, c.b) > 0.06 and c.get_luminance() < 0.62
	var red := c.r - maxf(c.g, c.b) > 0.42
	return green or red


func _grid(img: Image, cols: int, rows: int) -> Array[Rect2]:
	## Cells of a regular pip grid, in reading order. Pips may touch (rims, shadows), so cells
	## are found from the pip-ink column/row profiles rather than from connected blobs.
	var zone := _face_zone()
	var m := _mask(img, zone, func(c: Color, _b: Color) -> bool: return _is_pip(c))
	var w := img.get_width()
	var px := PackedFloat32Array()
	px.resize(w)
	var py := PackedFloat32Array()
	py.resize(img.get_height())
	for i in m.size():
		if m[i] == 1:
			px[i % w] += 1.0
			py[i / w] += 1.0
	var xb := _bands(px, cols)
	var yb := _bands(py, rows)
	var out: Array[Rect2] = []
	if xb.size() != cols or yb.size() != rows:
		return out
	for r in rows:
		for c in cols:
			# Tighten each cell to the ink actually inside it.
			var cell := Rect2i(xb[c].x, yb[r].x, xb[c].y - xb[c].x, yb[r].y - yb[r].x)
			var box := Rect2i()
			for y in range(cell.position.y, cell.end.y):
				for x in range(cell.position.x, cell.end.x):
					if m[y * w + x] == 1:
						box = Rect2i(x, y, 1, 1) if box.size == Vector2i.ZERO else box.expand(Vector2i(x, y)).expand(Vector2i(x + 1, y + 1))
			out.append(Rect2(box))
	return out


func _bands(profile: PackedFloat32Array, k: int) -> Array[Vector2i]:
	## Splits the inked span of a profile into k bands at the profile minima near the
	## expected boundaries. Ignores sparse ink (petal tips) below 15% of the peak.
	var peak := 0.0
	for v in profile:
		peak = maxf(peak, v)
	var lo := -1
	var hi := -1
	for i in profile.size():
		if profile[i] >= peak * 0.15:
			if lo < 0:
				lo = i
			hi = i + 1
	var out: Array[Vector2i] = []
	if lo < 0:
		return out
	var cuts: Array[int] = [lo]
	var span := float(hi - lo)
	for j in range(1, k):
		var expect := lo + span * j / k
		var best := roundi(expect)
		for i in range(roundi(expect - span * 0.12), roundi(expect + span * 0.12) + 1):
			if profile[i] < profile[best]:
				best = i
		cuts.append(best)
	cuts.append(hi)
	for j in k:
		out.append(Vector2i(cuts[j], cuts[j + 1]))
	return out


func _extract(img: Image, blank: Image, r: Rect2) -> Image:
	## Pip sprite with alpha recovered from its difference to the blank face (un-composited).
	var rr := Rect2i(r.grow(3)).intersection(Rect2i(Vector2i.ZERO, img.get_size()))
	var out := Image.create(rr.size.x, rr.size.y, false, Image.FORMAT_RGBA8)
	for y in rr.size.y:
		for x in rr.size.x:
			var c := img.get_pixel(rr.position.x + x, rr.position.y + y)
			var b := blank.get_pixel(rr.position.x + x, rr.position.y + y)
			var a := clampf((_dist(c, b) - 0.03) / 0.14, 0.0, 1.0)
			if a <= 0.0:
				continue
			var fg := Color((c.r - b.r * (1.0 - a)) / a, (c.g - b.g * (1.0 - a)) / a, (c.b - b.b * (1.0 - a)) / a, a)
			out.set_pixel(x, y, Color(clampf(fg.r, 0, 1), clampf(fg.g, 0, 1), clampf(fg.b, 0, 1), a))
	return out


func _cleared(face: Image, blank: Image) -> Image:
	## The face with every pip (and anything else inside the pip area) painted out.
	var img := face.duplicate()
	var m := _pip_mask(img, blank)
	# Only clear inside the central pip area so corner petals and clouds survive.
	var keep := PackedByteArray()
	keep.resize(m.size())
	var core := Rect2i(_face_zone()).grow_individual(-6, -2, -6, -2)
	for y in range(core.position.y, core.end.y):
		for x in range(core.position.x, core.end.x):
			keep[y * img.get_width() + x] = m[y * img.get_width() + x]
	_inpaint(img, _dilate(keep, img.get_size(), 3))
	return img


func _stamp(dst: Image, sprite: Image, centre: Vector2, k: float) -> void:
	var s := sprite
	if not is_equal_approx(k, 1.0):
		s = sprite.duplicate()
		s.resize(maxi(1, roundi(sprite.get_width() * k)), maxi(1, roundi(sprite.get_height() * k)), Image.INTERPOLATE_LANCZOS)
	dst.blend_rect(s, Rect2i(Vector2i.ZERO, s.get_size()), Vector2i(roundi(centre.x - s.get_width() * 0.5), roundi(centre.y - s.get_height() * 0.5)))


# --- props ---------------------------------------------------------------------------

func _build_props() -> void:
	for f in DirAccess.get_files_at(pack + "04_environment_props/individual"):
		if f.get_extension() != "png":
			continue
		var img := _load("04_environment_props/individual/" + f)
		if PROP_GOLD_LEFTOVERS.has(f):
			_clear_gold_below(img, PROP_GOLD_LEFTOVERS[f])
		_drop_fragments(img)
		var box := _alpha_bbox(img, 0.02)
		var part := img.get_region(box)
		var side := maxi(part.get_width(), part.get_height())
		var sq := Image.create(side, side, false, Image.FORMAT_RGBA8)
		sq.blit_rect(part, Rect2i(Vector2i.ZERO, part.get_size()), Vector2i((side - part.get_width()) / 2, side - part.get_height()))
		_save(sq, "props/hi/" + f, "trimmed, fragments removed, bottom-centred square")
		var lo := sq.duplicate()
		var lo_side := mini(side, 192)
		lo.resize(lo_side, lo_side, Image.INTERPOLATE_LANCZOS)
		_save(lo, "props/lo/" + f, "low-memory copy (<=192px)")


func _drop_fragments(img: Image) -> void:
	## Clears opaque islands much smaller than the main object (sprite-sheet cut leftovers).
	var w := img.get_width()
	var h := img.get_height()
	var lab := PackedInt32Array()
	lab.resize(w * h)
	var areas: Array[int] = [0]
	for start in w * h:
		if lab[start] != 0 or img.get_pixel(start % w, start / w).a <= 0.05:
			continue
		var id := areas.size()
		areas.append(0)
		var stack: PackedInt32Array = [start]
		lab[start] = id
		while not stack.is_empty():
			var i: int = stack[stack.size() - 1]
			stack.resize(stack.size() - 1)
			areas[id] += 1
			var x := i % w
			for d in [1, -1, w, -w]:
				var j: int = i + d
				if j < 0 or j >= w * h or lab[j] != 0 or absi((j % w) - x) > 1:
					continue
				if img.get_pixel(j % w, j / w).a > 0.05:
					lab[j] = id
					stack.append(j)
	var big := 0
	for a in areas:
		big = maxi(big, a)
	for i in w * h:
		if lab[i] != 0 and areas[lab[i]] < big * 0.03:
			img.set_pixel(i % w, i / w, Color(0, 0, 0, 0))


