func _build_placeholders() -> void:
	## Rose (destructive-action) buttons: the pack has none. Hue-shift the violet buttons'
	## violet pixels to rose; the gold rim and highlights keep their colour.
	for size in ["large", "small"]:
		for st in ["normal", "pressed", "disabled"]:
			var img := _load("03_ui/localizable/buttons/violet_%s_%s.png" % [size, st])
			for y in img.get_height():
				for x in img.get_width():
					var c := img.get_pixel(x, y)
					if c.a > 0.0 and c.s > 0.18 and c.h > 0.62 and c.h < 0.86:
						c.h = fposmod(c.h + 0.2, 1.0)
						img.set_pixel(x, y, c)
			var rel := "ui/buttons/rose_%s_%s.png" % [size, st]
			_save(img, rel, "placeholder")
			manifest.placeholders.append({"file": OUT + rel, "why": "pack has no rose/destructive button; hue-shifted from violet"})


func _clear_gold_below(img: Image, from_y: float) -> void:
	## Finds the finial by its saturated gold, then clears its box (shaded parts included)
	## except the grey rock it overlaps.
	var box := Rect2i()
	for y in range(int(img.get_height() * from_y), img.get_height()):
		for x in img.get_width():
			var c := img.get_pixel(x, y)
			if c.a > 0.05 and c.h > 0.07 and c.h < 0.14 and c.s > 0.62 and c.v > 0.45:
				box = Rect2i(x, y, 1, 1) if box.size == Vector2i.ZERO else box.expand(Vector2i(x, y)).expand(Vector2i(x + 1, y + 1))
	if box.size == Vector2i.ZERO:
		return
	box = box.grow_individual(5, 1, 5, img.get_height()).intersection(Rect2i(Vector2i.ZERO, img.get_size()))
	for y in range(box.position.y, box.end.y):
		for x in range(box.position.x, box.end.x):
			var c := img.get_pixel(x, y)
			if not (c.s < 0.25 and c.v > 0.3 and c.a > 0.6):
				img.set_pixel(x, y, Color(0, 0, 0, 0))
	manifest.repaired.append({"prop": "pink_flower_bush", "why": "removed a neighbouring sprite's gold finial left by the sheet cut"})


func _build_switch_knobs() -> void:
	## The pack's switches are plain pills, so on/off differ only by colour (not readable for
	## colour-blind players). Add an ivory knob with a gold rim: right = on, left = off.
	for st in ["on", "off"]:
		var img := _load("03_ui/localizable/components/switch_%s.png" % st)
		var box := _alpha_bbox(img)
		var r := box.size.y * 0.36
		var cy := box.get_center().y
		var cx := box.end.x - box.size.y * 0.5 if st == "on" else box.position.x + box.size.y * 0.5
		var knob := Image.create(img.get_width(), img.get_height(), false, Image.FORMAT_RGBA8)
		for y in img.get_height():
			for x in img.get_width():
				var d := Vector2(x + 0.5 - cx, y + 0.5 - cy).length()
				var shadow := Vector2(x + 0.5 - cx, y + 0.5 - cy - r * 0.12).length()
				var a := clampf(r - d, 0.0, 1.0)
				if a > 0.0:
					var rim := clampf(d - (r - r * 0.16), 0.0, 1.0)
					knob.set_pixel(x, y, Color(Color("FFF8EC").lerp(Color("D9A84E"), rim), a))
				elif shadow < r + 2.0:
					knob.set_pixel(x, y, Color(0, 0, 0, 0.18 * clampf(r + 2.0 - shadow, 0.0, 1.0)))
		img.blend_rect(knob, Rect2i(Vector2i.ZERO, knob.get_size()), Vector2i.ZERO)
		var rel := "ui/components/switch_%s_knob.png" % st
		_save(img, rel, "placeholder")
		manifest.placeholders.append({"file": OUT + rel, "why": "pack switches have no knob; ivory knob added so state is not colour-only"})
