extends SceneTree
## Headless content validator.
##   godot --headless --path . -s res://tools/validate_content.gd [-- --generated=500]
## - Validates all pack levels (structure, face counts, witness replay, independent solve).
## - Measures difficulty metrics per level (DifficultyAnalyzer).
## - Generates a deterministic sample of boards (pack layouts + procedural layouts) and
##   validates each one, plus the next 60 days of daily puzzles.
## Writes docs/reports/content_validation.md and docs/reports/difficulty.json.
## Exit code 1 if anything that would reach players is invalid.

func _initialize() -> void:
	var generated_n := 300
	for a in OS.get_cmdline_user_args():
		if a.begins_with("--generated="):
			generated_n = int(a.trim_prefix("--generated="))
	var t0 := Time.get_ticks_msec()
	var md := PackedStringArray()
	md.append("# Content validation report")
	md.append("")
	md.append("Generated by `tools/validate_content.gd` with Godot %s on %s." % [Engine.get_version_info().string, Time.get_datetime_string_from_system(false, true)])
	md.append("")
	var fail_count := 0

	# --- pack levels -------------------------------------------------------------------
	# Shipped journey: pack 1-50 + generated 51-150 (LevelCatalog).
	var raw: Array = LevelCatalog.load_merged()
	var diff_rows: Array = []
	md.append("## Shipped levels (1-50 supplied pack, 51-150 generated by tools/build_levels.gd)")
	md.append("")
	md.append("| Level | World | Tiles | Layers | Opening pairs | Dead-end rate (random play) | Solver nodes | Stored band | Measured band | Status |")
	md.append("|---|---|---|---|---|---|---|---|---|---|")
	var pack_ok := 0
	for d in raw:
		var L := LevelDefinition.from_dict(d)
		var rep := BoardValidator.validate(L, 300000)
		var an := DifficultyAnalyzer.analyze(L)
		an["id"] = L.id
		an["pack_band"] = L.difficulty_band
		diff_rows.append(an)
		var status := "PASS" if rep.ok and rep.witness_legal else "FAIL: " + ", ".join(rep.errors)
		if status == "PASS":
			pack_ok += 1
		else:
			fail_count += 1
		md.append("| %d | %s | %d | %d | %d | %.2f | %d | %s | %s | %s |" % [L.id, L.world, an.tiles, an.layers, an.opening_pairs, an.dead_end_rate, an.solver_nodes, L.difficulty_band, an.band, status])
	md.insert(6, "**Pack levels: %d / %d PASS** (witness replayed legally move-by-move AND independently solved by the engine solver).\n" % [pack_ok, raw.size()])

	# --- pacing summary per world ------------------------------------------------------
	md.append("")
	md.append("## Pacing summary (measured)")
	md.append("")
	md.append("| Range | Avg tiles | Avg layers | Avg dead-end rate | Avg score |")
	md.append("|---|---|---|---|---|")
	for r in [[1, 5], [6, 20], [21, 50], [51, 100], [101, 150]]:
		var n := 0
		var st := 0.0
		var sl := 0.0
		var sd := 0.0
		var ss := 0.0
		for row in diff_rows:
			if row.id >= r[0] and row.id <= r[1]:
				n += 1
				st += row.tiles
				sl += row.layers
				sd += row.dead_end_rate
				ss += row.score
		md.append("| %d-%d | %.1f | %.2f | %.2f | %.1f |" % [r[0], r[1], st / n, sl / n, sd / n, ss / n])

	# --- generated sample --------------------------------------------------------------
	var layouts: Array = JSON.parse_string(FileAccess.get_file_as_string("res://data/levels/layouts_50.json"))
	var gen := BoardGenerator.new()
	var gen_ok := 0
	var gen_rejected_geometry := 0
	var gen_bad := 0
	for k in generated_n:
		var positions: Array = []
		if k % 2 == 0:
			for p in layouts[k % layouts.size()].positions:
				positions.append(Vector3i(int(p[0]) * 2, int(p[1]) * 2, int(p[2])))
		else:
			positions = LayoutGenerator.generate(SeededRng.new(SeededRng.hash_string("sample-%d" % k)), 60 + (k % 5) * 12)
		var L := gen.generate_level(positions, "sample-%d" % k)
		if not L.is_valid():
			gen_rejected_geometry += 1  # honestly rejected; never shipped
			continue
		var rep := BoardValidator.validate(L, 200000)
		if rep.ok:
			gen_ok += 1
		else:
			gen_bad += 1
			fail_count += 1
			print("generated board %d invalid: %s" % [k, rep.errors])
	md.append("")
	md.append("## Generated sample (deterministic seeds `sample-0..%d`)" % (generated_n - 1))
	md.append("")
	md.append("- Valid and independently verified: **%d**" % gen_ok)
	md.append("- Rejected by the generator before validation (unclearable geometry, reported honestly): %d" % gen_rejected_geometry)
	md.append("- Produced but failed validation (would be a bug): **%d**" % gen_bad)

	# --- daily puzzles -----------------------------------------------------------------
	var daily_ok := 0
	var daily_bad := 0
	var start := Time.get_unix_time_from_datetime_string("2026-10-01T00:00:00")
	for day in 60:
		var date := Time.get_date_string_from_unix_time(start + day * 86400)
		var L := DailyGenerator.build(date)
		if L != null and L.is_valid() and BoardValidator.validate(L, 200000).ok:
			daily_ok += 1
		else:
			daily_bad += 1
			fail_count += 1
	md.append("")
	md.append("## Daily puzzles 2026-10-01 .. +59 days")
	md.append("")
	md.append("- Valid: **%d**, invalid: **%d**" % [daily_ok, daily_bad])
	md.append("")
	md.append("Total runtime: %.1fs" % ((Time.get_ticks_msec() - t0) / 1000.0))

	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path("res://docs/reports"))
	var f := FileAccess.open("res://docs/reports/content_validation.md", FileAccess.WRITE)
	f.store_string("\n".join(md) + "\n")
	f.close()
	var fj := FileAccess.open("res://docs/reports/difficulty.json", FileAccess.WRITE)
	fj.store_string(JSON.stringify(diff_rows, "  "))
	fj.close()
	print("shipped %d/%d ok, generated %d ok / %d rejected / %d bad, daily %d ok / %d bad" % [pack_ok, raw.size(), gen_ok, gen_rejected_geometry, gen_bad, daily_ok, daily_bad])
	quit(1 if fail_count > 0 else 0)
