extends Node
## Game audio driven by assets/veya/audio/AUDIO_MAP.json (generated by tools/audio/make_audio.mjs).
##
## Effects
## - Pooled one-shot players on the SFX bus.
## - Frequent, non-tonal events (tap/select/button) have round-robin variants, never the same
##   variant twice in a row, plus a small random pitch (+-40 cents) and volume (+-1.5 dB) spread,
##   so thousands of repeats don't fatigue. Tonal events are never randomly detuned.
## - Match streaks climb the D-major pentatonic in tune with the music: play_match(combo).
## - Big moments (victory, world unlock, reward) briefly duck the music.
## Music
## - Each world has a small playlist of 2-3 minute pieces. A piece plays once, then a short
##   silence, then the other piece - research on long casual sessions: varied, non-repetitive
##   music with breathing room is less fatiguing than a short loop.
## Buses: Master > Music, SFX, Ambience. Interruptions: music pauses while backgrounded.

const MAP_PATH := "res://assets/veya/audio/AUDIO_MAP.json"
const AUDIO_ROOT := "res://assets/veya/audio/"
const POOL_SIZE := 8
const FADE_S := 1.4
const GAP_MIN_S := 12.0
const GAP_MAX_S := 28.0
## Semitone offsets of D major pentatonic (D E F# A B D): a match streak climbs one step per
## consecutive match and stays at the octave.
const COMBO_STEPS: Array[int] = [0, 2, 4, 7, 9, 12]
const VARIED := {"tap": true, "select": true, "button": true}
const PITCH_SPREAD := 0.0234   # ~ +-40 cents
const VOLUME_SPREAD_DB := 1.5
const DUCK := {"victory": [-9.0, 2.6], "world_unlock": [-9.0, 4.2], "reward": [-5.0, 1.4]}

var _sfx: Dictionary = {}        # event -> Array[AudioStream] (variants)
var _last_variant: Dictionary = {}
var _playlists: Dictionary = {}  # world -> Array[String] paths
var _pool: Array[AudioStreamPlayer] = []
var _pool_i: int = 0
var _music_a: AudioStreamPlayer
var _music_b: AudioStreamPlayer
var _music_world: String = ""
var _track_i: int = 0
var _music_tween: Tween
var _duck_tween: Tween
var _gap_timer: Timer
var _rng := RandomNumberGenerator.new()


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_rng.randomize()
	_ensure_bus("Music")
	_ensure_bus("SFX")
	_ensure_bus("Ambience")
	_load_map()
	for i in POOL_SIZE:
		var p := AudioStreamPlayer.new()
		p.bus = "SFX"
		add_child(p)
		_pool.append(p)
	_music_a = _make_music_player()
	_music_b = _make_music_player()
	_gap_timer = Timer.new()
	_gap_timer.one_shot = true
	_gap_timer.timeout.connect(_start_next_track)
	add_child(_gap_timer)
	apply_settings()
	GameState.settings_changed.connect(func(_k: String) -> void: apply_settings())


func _load_map() -> void:
	var map: Variant = JSON.parse_string(FileAccess.get_file_as_string(MAP_PATH))
	if typeof(map) != TYPE_DICTIONARY:
		push_warning("AudioService: AUDIO_MAP.json missing or invalid")
		return
	var events: Dictionary = map.get("events", {})
	for ev in events:
		var files: Array = events[ev] if typeof(events[ev]) == TYPE_ARRAY else [events[ev]]
		var streams: Array = []
		for f in files:
			var p: String = AUDIO_ROOT + str(f)
			if ResourceLoader.exists(p):
				streams.append(load(p))
		if not streams.is_empty():
			_sfx[ev] = streams
	var music: Dictionary = map.get("music", {})
	for w in music:
		var list: Array = []
		for f in music[w]:
			list.append(AUDIO_ROOT + str(f))
		_playlists[w] = list


func _make_music_player() -> AudioStreamPlayer:
	var p := AudioStreamPlayer.new()
	p.bus = "Music"
	p.volume_db = -80.0
	p.finished.connect(_on_track_finished.bind(p))
	add_child(p)
	return p


func _ensure_bus(name: String) -> void:
	if AudioServer.get_bus_index(name) == -1:
		AudioServer.add_bus()
		var idx := AudioServer.bus_count - 1
		AudioServer.set_bus_name(idx, name)
		AudioServer.set_bus_send(idx, "Master")


static func linear_to_db_safe(v: float) -> float:
	return -80.0 if v <= 0.001 else linear_to_db(v)


func apply_settings() -> void:
	var music_on := bool(GameState.setting("music_on"))
	var sfx_on := bool(GameState.setting("sfx_on"))
	var mi := AudioServer.get_bus_index("Music")
	var si := AudioServer.get_bus_index("SFX")
	AudioServer.set_bus_volume_db(mi, linear_to_db_safe(float(GameState.setting("music_volume"))))
	AudioServer.set_bus_volume_db(si, linear_to_db_safe(float(GameState.setting("sfx_volume"))))
	AudioServer.set_bus_mute(mi, not music_on)
	AudioServer.set_bus_mute(si, not sfx_on)


# --- effects --------------------------------------------------------------------------

func _pick(event: String) -> AudioStream:
	var list: Array = _sfx[event]
	if list.size() == 1:
		return list[0]
	var last := int(_last_variant.get(event, -1))
	var i := _rng.randi_range(0, list.size() - 2)
	if i >= last and last >= 0:
		i += 1  # never the same variant twice in a row
	_last_variant[event] = i
	return list[i]


func play(event: String, pitch: float = 1.0) -> void:
	if not _sfx.has(event) or not bool(GameState.setting("sfx_on")):
		return
	var p := _pool[_pool_i]
	_pool_i = (_pool_i + 1) % _pool.size()
	p.stream = _pick(event)
	var vol := 0.0
	if VARIED.has(event):
		pitch *= 1.0 + _rng.randf_range(-PITCH_SPREAD, PITCH_SPREAD)
		vol = _rng.randf_range(-VOLUME_SPREAD_DB, VOLUME_SPREAD_DB)
	p.pitch_scale = pitch
	p.volume_db = vol
	p.play()
	if DUCK.has(event):
		_duck(DUCK[event][0], DUCK[event][1])


static func combo_pitch(combo: int) -> float:
	## Pitch scale for the n-th consecutive match (1-based), in tune with the music.
	var step: int = COMBO_STEPS[clampi(combo - 1, 0, COMBO_STEPS.size() - 1)]
	return pow(2.0, step / 12.0)


func play_match(combo: int) -> void:
	play("match", combo_pitch(combo))


# --- music ----------------------------------------------------------------------------

func play_world_music(world_id: String) -> void:
	if world_id == _music_world or not _playlists.has(world_id) or (_playlists[world_id] as Array).is_empty():
		return
	_music_world = world_id
	_track_i = _rng.randi_range(0, (_playlists[world_id] as Array).size() - 1)
	_gap_timer.stop()
	_start_track(_playlists[world_id][_track_i])


func _start_track(path: String) -> void:
	var stream: AudioStream = load(path)
	if stream == null:
		return
	if stream is AudioStreamOggVorbis:
		(stream as AudioStreamOggVorbis).loop = false  # pieces end naturally; a gap follows
	if _duck_tween:
		_duck_tween.kill()
	# Cross-fade: incoming on B, outgoing A fades out; then swap roles.
	var incoming := _music_b
	var outgoing := _music_a
	incoming.stream = stream
	incoming.volume_db = -40.0
	incoming.play()
	if _music_tween:
		_music_tween.kill()
	_music_tween = create_tween().set_parallel(true)
	_music_tween.tween_property(incoming, "volume_db", 0.0, FADE_S)
	if outgoing.playing:
		_music_tween.tween_property(outgoing, "volume_db", -60.0, FADE_S)
		_music_tween.chain().tween_callback(outgoing.stop)
	_music_a = incoming
	_music_b = outgoing


func _on_track_finished(player: AudioStreamPlayer) -> void:
	if player != _music_a or _music_world == "":
		return
	_gap_timer.start(_rng.randf_range(GAP_MIN_S, GAP_MAX_S))


func _start_next_track() -> void:
	var list: Array = _playlists.get(_music_world, [])
	if list.is_empty():
		return
	_track_i = (_track_i + 1) % list.size()
	_start_track(list[_track_i])


func _duck(depth_db: float, hold_s: float) -> void:
	if not _music_a.playing:
		return
	if _duck_tween:
		_duck_tween.kill()
	_duck_tween = create_tween()
	_duck_tween.tween_property(_music_a, "volume_db", depth_db, 0.15)
	_duck_tween.tween_interval(maxf(0.0, hold_s - 0.15))
	_duck_tween.tween_property(_music_a, "volume_db", 0.0, 1.2)


func stop_music() -> void:
	_music_world = ""
	_gap_timer.stop()
	_music_a.stop()
	_music_b.stop()


func _notification(what: int) -> void:
	match what:
		NOTIFICATION_APPLICATION_PAUSED, NOTIFICATION_APPLICATION_FOCUS_OUT:
			_music_a.stream_paused = true
			if _gap_timer:
				_gap_timer.paused = true
		NOTIFICATION_APPLICATION_RESUMED, NOTIFICATION_APPLICATION_FOCUS_IN:
			_music_a.stream_paused = false
			if _gap_timer:
				_gap_timer.paused = false
